{
  "name": "kindle-dashboard",
  "version": "2.0.0",
  "description": "Kindle 霸屏日程看板 — Cloudflare Workers + D1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute kindle-dashboard --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute kindle-dashboard --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.90.0"
  }
}
